
@page "/forgot-password"
@rendermode InteractiveServer

@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IAuthService AuthService

<PageTitle>Resetowanie hasła</PageTitle>

<div class="container mt-5" style="max-width: 500px;">
    <h3>Nie pamiętasz hasła?</h3>

    <p>
        Skontaktuj się z administratorem, aby otrzymać hasło tymczasowe.
        Jest ono ważne przez 30 minut i może być użyte tylko raz.
    </p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(success ? "alert-success" : "alert-danger")">
            @message
        </div>
    }

    <EditForm Model="@form" OnValidSubmit="ResetPassword">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Login lub e-mail</label>
            <InputText class="form-control"
                       @bind-Value="form.LoginOrEmail" />
        </div>

        <div class="mb-3">
            <label class="form-label">Hasło tymczasowe</label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="form.TemporaryPassword" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nowe hasło</label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="form.NewPassword" />
        </div>

        <div class="mb-3">
            <label class="form-label">Powtórz nowe hasło</label>
            <InputText class="form-control"
                       type="password"
                       @bind-Value="form.ConfirmPassword" />
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Ustaw nowe hasło
        </button>
    </EditForm>

    <p class="mt-3">
        <a href="/login">Wróć do logowania</a>
    </p>
</div>

@code {
    private ResetPasswordForm form = new();
    private string message = string.Empty;
    private bool success;

    private async Task ResetPassword()
    {
        message = string.Empty;
        success = false;

        if (form.NewPassword != form.ConfirmPassword)
        {
            message = "Podane nowe hasła nie są identyczne.";
            return;
        }

        try
        {
            bool result =
                await AuthService.ResetPasswordWithTemporaryPasswordAsync(
                    form.LoginOrEmail,
                    form.TemporaryPassword,
                    form.NewPassword);

            if (result)
            {
                success = true;
                message = "Hasło zostało zmienione. Możesz się teraz zalogować.";
                form = new ResetPasswordForm();
            }
            else
            {
                message =
                    "Hasło tymczasowe jest nieprawidłowe, wygasło lub nie można go użyć.";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private class ResetPasswordForm
    {
        public string LoginOrEmail { get; set; } = string.Empty;
        public string TemporaryPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
