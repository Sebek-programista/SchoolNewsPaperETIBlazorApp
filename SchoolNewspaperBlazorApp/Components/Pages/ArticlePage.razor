
@page "/article/{Id:int}"

@using System.Net
@using System.Globalization
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service

@inject IArticleService articleService
@inject IFileService fileService

@if (loading)
{
    <div class="article-loading">
        <p>Ładowanie artykułu...</p>
    </div>
}
else if (article == null)
{
    <div class="article-not-found">
        <h1>Nie znaleziono artykułu</h1>
        <p>Artykuł nie istnieje lub został usunięty.</p>
    </div>
}
else
{
    <article class="article-page">

        <section class="article-layout">

            <div class="article-category-label">
                @GetCategoryName(article.Category)
            </div>

            @if (!string.IsNullOrWhiteSpace(imageUrl))
            {
                <div class="article-hero">
                    <img src="@imageUrl"
                         alt="@article.Title"
                         class="article-hero__image" />
                </div>
            }

            <header class="article-standard-header">
                <h1>@article.Title</h1>
                <p>Autor: @article.Author</p>
                <p>
                    Data publikacji:
                    @article.PublishDate.ToString("dd.MM.yyyy")
                </p>
            </header>

            @* DODATKOWE INFORMACJE Z FORMULARZA *@

            <section class="article-info-card">
                <h2>Informacje szczegółowe</h2>

                @switch (article.Category)
                {
                    case EnumArticleCategory.Announcments:
                        @if (article.AnnouncementDeadline.HasValue)
                        {
                            <p>
                                <strong>Termin obowiązywania:</strong>
                                @article.AnnouncementDeadline.Value.ToString("dd.MM.yyyy")
                            </p>
                        }
                        break;

                    case EnumArticleCategory.Substitute:
                        @if (article.SubstituteDate.HasValue)
                        {
                            <p>
                                <strong>Data zastępstwa:</strong>
                                @article.SubstituteDate.Value.ToString("dd.MM.yyyy")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.SchoolClass))
                        {
                            <p>
                                <strong>Klasa:</strong>
                                @article.SchoolClass
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.Teacher))
                        {
                            <p>
                                <strong>Nauczyciel:</strong>
                                @article.Teacher
                            </p>
                        }
                        break;

                    case EnumArticleCategory.Events:
                        @if (article.EventDate.HasValue)
                        {
                            <p>
                                <strong>Data wydarzenia:</strong>
                                @article.EventDate.Value.ToString("dd.MM.yyyy")
                            </p>
                        }

                        @if (article.EventTime.HasValue)
                        {
                            <p>
                                <strong>Godzina:</strong>
                                @article.EventTime.Value.ToString("HH:mm")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.EventLocation))
                        {
                            <p>
                                <strong>Miejsce:</strong>
                                @article.EventLocation
                            </p>
                        }
                        break;

                    case EnumArticleCategory.Competitions:
                        @if (article.CompetitionDate.HasValue)
                        {
                            <p>
                                <strong>Data zawodów:</strong>
                                @article.CompetitionDate.Value.ToString("dd.MM.yyyy")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.CompetitionDiscipline))
                        {
                            <p>
                                <strong>Dyscyplina:</strong>
                                @article.CompetitionDiscipline
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.CompetitionLocation))
                        {
                            <p>
                                <strong>Miejsce zawodów:</strong>
                                @article.CompetitionLocation
                            </p>
                        }
                        break;

                    case EnumArticleCategory.Admisions:
                        @if (article.AdmissionsStart.HasValue)
                        {
                            <p>
                                <strong>Początek rekrutacji:</strong>
                                @article.AdmissionsStart.Value.ToString("dd.MM.yyyy")
                            </p>
                        }

                        @if (article.AdmissionsEnd.HasValue)
                        {
                            <p>
                                <strong>Koniec rekrutacji:</strong>
                                @article.AdmissionsEnd.Value.ToString("dd.MM.yyyy")
                            </p>
                        }
                        break;

                    case EnumArticleCategory.Exams:
                        @if (article.ExamDate.HasValue)
                        {
                            <p>
                                <strong>Data egzaminu:</strong>
                                @article.ExamDate.Value.ToString("dd.MM.yyyy")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.ExamSubject))
                        {
                            <p>
                                <strong>Przedmiot:</strong>
                                @article.ExamSubject
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(article.ExamClass))
                        {
                            <p>
                                <strong>Klasa:</strong>
                                @article.ExamClass
                            </p>
                        }
                        break;

                    case EnumArticleCategory.StudentCouncil:
                        @if (!string.IsNullOrWhiteSpace(article.CouncilInitiative))
                        {
                            <p>
                                <strong>Rodzaj inicjatywy:</strong>
                                @article.CouncilInitiative
                            </p>
                        }
                        break;
                }
            </section>

            @* TREŚĆ ARTYKUŁU *@

            <div class="article-body">
                @((MarkupString)FormattedText)
            </div>

        </section>

        @* GALERIA ZDJĘĆ *@

        @if (galleryImages.Count > 0)
        {
            <section class="article-gallery-section">
                <div class="article-gallery-heading">
                    <span>GALERIA</span>
                    <h2>Galeria zdjęć</h2>
                    <p>Zdjęcia związane z publikacją.</p>
                </div>

                <div class="gallery">
                    @foreach (var image in galleryImages)
                    {
                        <button @key="image"
                                type="button"
                                class="article-gallery-item"
                                @onclick="() => OpenPreview(image)"
                                aria-label="Powiększ zdjęcie">

                            <img src="@image"
                                 alt="Zdjęcie artykułu" />

                            <span class="article-gallery-item__overlay">
                                Powiększ zdjęcie
                            </span>
                        </button>
                    }
                </div>
            </section>
        }

        @* PODGLĄD ZDJĘCIA *@

        @if (!string.IsNullOrWhiteSpace(selectedImage))
        {
            <div class="image-preview-overlay"
                 @onclick="ClosePreview">

                <div class="image-preview-window"
                     @onclick:stopPropagation="true">

                    <div class="image-preview-header">
                        <div class="image-preview-heading">
                            <span class="image-preview-label">
                                GALERIA ZDJĘĆ
                            </span>
                            <span class="image-preview-subtitle">
                                Podgląd fotografii
                            </span>
                        </div>

                        <button type="button"
                                class="image-preview-close"
                                @onclick="ClosePreview"
                                aria-label="Zamknij podgląd">
                            &times;
                        </button>
                    </div>

                    <div class="image-preview-content">
                        <img src="@selectedImage"
                             alt="Podgląd zdjęcia"
                             class="image-preview-large" />
                    </div>

                    <div class="image-preview-footer">
                        <span>Szkolna gazeta</span>
                        <span>Podgląd zdjęcia</span>
                    </div>
                </div>
            </div>
        }

    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Article? article;
    private string? imageUrl;
    private List<string> galleryImages = new();
    private string? selectedImage;
    private bool loading = true;

    private string FormattedText =>
        WebUtility.HtmlEncode(article?.Text ?? "Brak treści artykułu.")
            .Replace("\r\n", "\n")
            .Replace("\r", "\n")
            .Replace("\n", "<br />");

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        article = null;
        imageUrl = null;
        galleryImages.Clear();
        selectedImage = null;

        try
        {
            article = await articleService.GetArticleByIdAsync(Id);

            if (article.MainImageId > 0)
            {
                var fileName = await fileService.GetFileNameByIdAsync(
                    article.MainImageId);

                if (!string.IsNullOrWhiteSpace(fileName))
                {
                    imageUrl = $"/Images/{fileName}";
                }
            }

            galleryImages =
                await fileService.GetImagesByArticleIdAsync(Id)
                ?? new List<string>();
        }
        catch (Exception)
        {
            article = null;
        }
        finally
        {
            loading = false;
        }
    }

    private static string GetCategoryName(EnumArticleCategory category)
    {
        return category switch
        {
            EnumArticleCategory.Announcments => "OGŁOSZENIA",
            EnumArticleCategory.Substitute => "ZASTĘPSTWA",
            EnumArticleCategory.Events => "WYDARZENIA SZKOLNE",
            EnumArticleCategory.Competitions => "ZAWODY I KONKURSY",
            EnumArticleCategory.Admisions => "REKRUTACJA",
            EnumArticleCategory.Exams => "EGZAMINY",
            EnumArticleCategory.StudentCouncil => "SAMORZĄD UCZNIOWSKI",
            _ => "ARTYKUŁ"
        };
    }

    private void OpenPreview(string image)
    {
        selectedImage = image;
    }

    private void ClosePreview()
    {
        selectedImage = null;
    }
}
