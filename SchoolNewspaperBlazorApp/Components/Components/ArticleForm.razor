
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@using Microsoft.AspNetCore.Components.Forms
@inject IArticleService articleService
@inject IFileService fileService
@inject ToastService toastService

<div class="add-article-form">
    <h1 class="add-article-form__title">
        @(IsEdit ? "Edytuj artykuł" : "Dodaj artykuł")
    </h1>

    <label class="form-label">
        @(IsEdit ? "Nowe zdjęcie (zastąpi obecną okładkę)" : "Zdjęcia artykułu")
    </label>

    <InputFile @key="formKey"
               OnChange="ChoosePhotos"
               accept="image/*"
               multiple="@(!IsEdit)"
               class="form-control mb-3" />

    @if (photos.Count > 0)
    {
        <div class="article-form-photos">
            @for (var i = 0; i < photos.Count; i++)
            {
                var index = i;

                <div class="article-form-photo">
                    <img src="@photos[index].Preview"
                         alt="Zdjęcie @(index + 1)" />

                    @if (index == 0)
                    {
                        <span class="article-form-photo__cover">
                            Okładka
                        </span>
                    }

                    <button type="button"
                            class="article-form-photo__remove"
                            aria-label="Usuń zdjęcie"
                            @onclick="() => RemovePhoto(index)">
                        ×
                    </button>
                </div>
            }
        </div>
    }

    <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
        <label class="form-label">Typ wydarzenia</label>

        <select @bind="eventType" class="form-select mb-4">
            <option value="">Zwykły artykuł (bez typu)</option>
            @foreach (var t in Enum.GetValues<ArticleType>())
            {
                <option value="@t">@t.ToLabel()</option>
            }
        </select>

        @switch (eventType)
        {
            case ArticleType.Announcements:
                <label class="form-label">Tytuł ogłoszenia</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Tytuł ogłoszenia..." />

                <label class="form-label">Treść ogłoszenia</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Treść ogłoszenia..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.Substitute:
                <label class="form-label">Informacje o zastępstwie</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Np. Zastępstwo z matematyki" />

                <label class="form-label">Szczegóły zastępstwa</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Klasa, lekcja, nauczyciel..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.Events:
                <label class="form-label">Nazwa wydarzenia</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Nazwa wydarzenia..." />

                <label class="form-label">Opis wydarzenia</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Opis wydarzenia..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.Competitions:
                <label class="form-label">Nazwa zawodów</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Nazwa zawodów..." />

                <label class="form-label">Opis zawodów i wyniki</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Opisz zawody i wyniki..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.Admissions:
                <label class="form-label">Tytuł informacji rekrutacyjnej</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Np. Rekrutacja na rok szkolny..." />

                <label class="form-label">Informacje o rekrutacji</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Terminy, zasady, wymagania..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.Exams:
                <label class="form-label">Nazwa egzaminu</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Np. Egzamin ósmoklasisty" />

                <label class="form-label">Informacje o egzaminie</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Terminy i ważne informacje..."
                          style="resize:none"></textarea>
                break;

            case ArticleType.StudentCouncil:
                <label class="form-label">Tytuł informacji samorządu</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Tytuł informacji..." />

                <label class="form-label">Treść informacji</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Informacja od samorządu..."
                          style="resize:none"></textarea>
                break;

            default:
                <label class="form-label">Tytuł</label>
                <input @bind="title"
                       @bind:event="oninput"
                       class="form-control mb-3"
                       placeholder="Wpisz tytuł..." />

                <label class="form-label">Treść</label>
                <textarea @bind="text"
                          @bind:event="oninput"
                          class="form-control mb-3"
                          rows="6"
                          placeholder="Treść artykułu..."
                          style="resize:none"></textarea>
                break;
        }

        <button type="submit" class="btn btn-primary w-100">
            @(IsEdit ? "Zapisz zmiany" : "Dodaj artykuł")
        </button>

        @if (IsEdit && CanDelete)
        {
            <button type="button"
                    class="btn btn-outline-danger w-100 mt-2"
                    @onclick="DeleteAsync">
                Usuń artykuł
            </button>
        }
    </form>

    <section class="article-live-preview">
        <div class="article-live-preview__heading">
            <div>
                <span class="article-live-preview__eyebrow">
                    PODGLĄD NA ŻYWO
                </span>
                <h2>Tak będzie wyglądał artykuł</h2>
            </div>

            <span class="article-live-preview__status">
                <span></span>
                Na bieżąco
            </span>
        </div>

        <article class="article-preview-card">
            @if (photos.Count > 0)
            {
                <div class="article-preview-card__cover">
                    <img src="@photos[0].Preview" alt="Podgląd okładki" />

                    @if (eventType.HasValue)
                    {
                        <span class="article-preview-card__type">
                            @eventType.Value.ToLabel()
                        </span>
                    }
                </div>
            }
            else if (IsEdit && Article != null && !string.IsNullOrWhiteSpace(existingImageUrl))
            {
                <div class="article-preview-card__cover">
                    <img src="@existingImageUrl" alt="Obecna okładka artykułu" />

                    @if (eventType.HasValue)
                    {
                        <span class="article-preview-card__type">
                            @eventType.Value.ToLabel()
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="article-preview-card__placeholder">
                    <span>ETI</span>
                    <strong>Twoja okładka pojawi się tutaj</strong>
                    <small>Wybierz zdjęcie powyżej</small>
                </div>
            }

            <div class="article-preview-card__body">
                <div class="article-preview-card__meta">
                    <span>GAZETKA SZKOLNA</span>
                    @if (eventType.HasValue)
                    {
                        <span>@eventType.Value.ToLabel()</span>
                    }
                </div>

                <h3>
                    @(string.IsNullOrWhiteSpace(title)
                        ? "Tytuł Twojego artykułu"
                        : title)
                </h3>

                <p class="article-preview-card__text">
                    @(string.IsNullOrWhiteSpace(text)
                        ? "Tutaj pojawi się treść artykułu. Zacznij pisać w formularzu, a podgląd automatycznie się zaktualizuje."
                        : text)
                </p>

                @if (photos.Count > 1)
                {
                    <div class="article-preview-card__gallery">
                        @foreach (var photo in photos.Skip(1))
                        {
                            <img src="@photo.Preview" alt="Zdjęcie z galerii" />
                        }
                    </div>
                }

                <div class="article-preview-card__footer">
                    <div class="article-preview-card__avatar">
                        @GetAuthorInitial()
                    </div>

                    <div class="article-preview-card__author">
                        <strong>
                            @(IsEdit && Article != null
                                ? Article.AuthorDisplay
                                : "Autor artykułu")
                        </strong>
                        <span>Redakcja gazetki szkolnej</span>
                    </div>

                    <span class="article-preview-card__more">
                        Czytaj więcej <span>→</span>
                    </span>
                </div>
            </div>
        </article>

        <p class="article-live-preview__note">
            To przykładowy podgląd wyglądu artykułu. Ostateczny wygląd na stronie
            może zależeć od układu publikacji.
        </p>
    </section>
</div>

@code {
    private const int MaxFiles = 10;
    private readonly List<(IBrowserFile File, string Preview)> photos = new();

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public Article? Article { get; set; }

    [Parameter]
    public bool CanDelete { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string title = "";
    private string text = "";
    private ArticleType? eventType;
    private int formKey;
    private string? existingImageUrl;
    private int loadedArticleId = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (IsEdit && Article != null)
        {
            if (loadedArticleId != Article.Id)
            {
                title = Article.Title;
                text = Article.Text;
                eventType = Article.EventsType;
                photos.Clear();
                loadedArticleId = Article.Id;
            }

            if (string.IsNullOrWhiteSpace(existingImageUrl))
            {
                try
                {
                    var fileName = await fileService.GetFileNameByIdAsync(Article.FileId);

                    if (!string.IsNullOrWhiteSpace(fileName))
                    {
                        existingImageUrl = $"/Images/{fileName}";
                    }
                }
                catch
                {
                    existingImageUrl = null;
                }
            }
        }
        else
        {
            loadedArticleId = -1;
            existingImageUrl = null;
        }
    }

    private async Task SubmitForm()
    {
        toastService.Success("Kliknięto przycisk dodawania.");
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(text))
        {
            toastService.Error("Uzupełnij tytuł i treść artykułu.");
            return;
        }

        if (!IsEdit && photos.Count == 0)
        {
            toastService.Error("Dodając artykuł, musisz dodać zdjęcie.");
            return;
        }

        try
        {
            if (IsEdit && Article != null)
            {
                int fileId = Article.FileId;

                if (photos.Count > 0)
                {
                    fileId = await fileService.UploadImage(photos[0].File);
                }

                await articleService.UpdateArticleByIdAsync(
                    Article.Id, title, text, fileId, eventType);

                toastService.Success("Artykuł został zapisany.");
                ClearPhotos();
            }
            else
            {
                var fileIds = await fileService.UploadImagesAsync(
                    photos.Select(p => p.File));

                await articleService.AddArticleAsync(
                    title, text, fileIds, eventType);

                toastService.Success("Artykuł został dodany.");

                title = "";
                text = "";
                eventType = null;
                loadedArticleId = -1;
                existingImageUrl = null;
                ClearPhotos();
            }
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się zapisać artykułu.");
        }
    }

    private async Task DeleteAsync()
    {
        if (!CanDelete || Article == null)
        {
            return;
        }

        try
        {
            await articleService.RemoveArticleByIdAsync(Article.Id);
            toastService.Success("Artykuł został usunięty.");
            await OnDeleted.InvokeAsync();
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się usunąć artykułu.");
        }
    }

    private async Task ChoosePhotos(InputFileChangeEventArgs e)
    {
        IReadOnlyList<IBrowserFile> selected;

        try
        {
            selected = e.GetMultipleFiles(IsEdit ? 1 : MaxFiles);
        }
        catch (InvalidOperationException)
        {
            toastService.Error($"Możesz wybrać maksymalnie {MaxFiles} zdjęć naraz.");
            return;
        }

        if (IsEdit)
        {
            photos.Clear();
        }

        foreach (var f in selected)
        {
            if (photos.Count >= MaxFiles)
            {
                break;
            }

            try
            {
                photos.Add((f, await fileService.GetPreviewAsync(f)));
            }
            catch (Exception)
            {
                toastService.Error($"Nie udało się wczytać pliku {f.Name} (maks. 5 MB).");
            }
        }
    }

    private void RemovePhoto(int index)
    {
        if (index >= 0 && index < photos.Count)
        {
            photos.RemoveAt(index);
        }
    }

    private void ClearPhotos()
    {
        photos.Clear();
        formKey++;
    }

    private string GetAuthorInitial()
    {
        if (IsEdit && Article != null &&
            !string.IsNullOrWhiteSpace(Article.AuthorDisplay))
        {
            return Article.AuthorDisplay.Trim()[0].ToString().ToUpperInvariant();
        }

        return "R";
    }
}
