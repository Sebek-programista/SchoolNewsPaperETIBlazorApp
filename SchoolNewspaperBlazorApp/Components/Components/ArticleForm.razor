@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Emuns
@using SchoolNewspaperBlazorApp.Interfaces.Service

@inject IArticleService articleService
@inject IFileService fileService
@inject INotificationService notificationService

<div class="add-article-form">
    <h1 class="add-article-form__title">Dodaj artykuł</h1>

    @if (previewImage != null)
    {
        <div class="image-preview-wrap">
            <img src="@previewImage"
                 alt="zdjęcie"
                 class="image-preview" />
        </div>
    }

    <h1>@errorMessage</h1>

    <label class="form-label">Zdjęcie</label>
    <InputFile OnChange="ChoosePhoto"
               accept="image/*"
               class="form-control mb-3" />

    <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
        <label class="form-label">Tytuł</label>
        <input @bind="title"
               class="form-control mb-3"
               placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść</label>
        <textarea @bind="text"
                  class="form-control mb-3"
                  rows="6"
                  placeholder="Treść artykułu..."></textarea>

        <label class="form-label">Autor</label>
        <input @bind="author"
               class="form-control mb-4"
               placeholder="Imię i nazwisko" />

        <button type="submit" class="btn btn-primary w-100">
            @(IsEdit ? "Zatwierdź edycję" : "Dodaj artykuł")
        </button>
    </form>
</div>

@code {
    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public Article? Article { get; set; }

    private string title = "";
    private string text = "";
    private string author = "";
    private string? previewImage;
    private string? errorMessage;

    private IBrowserFile? file;

    protected override void OnParametersSet()
    {
        if (IsEdit && Article != null)
        {
            title = Article.Title;
            text = Article.Text;
            author = Article.Author;
        }
    }

    private async Task SubmitForm()
    {
        // Sprawdzenie tytułu
        if (string.IsNullOrWhiteSpace(title))
        {
            notificationService.Show(
                "Tytuł nie może być pusty!",
                EnumNotificationType.Faliure);

            return;
        }

        // Sprawdzenie treści
        if (string.IsNullOrWhiteSpace(text))
        {
            notificationService.Show(
                "Treść artykułu nie może być pusta!",
                EnumNotificationType.Faliure);

            return;
        }

        // Sprawdzenie zdjęcia przy dodawaniu nowego artykułu
        if (!IsEdit && file == null)
        {
            notificationService.Show(
                "Nie można dodać artykułu bez zdjęcia!",
                EnumNotificationType.Faliure);

            return;
        }

        int id = 0;

        // Wysyłanie zdjęcia
        if (file != null)
        {
            id = await fileService.UploadImage(file);
        }

        // Edycja istniejącego artykułu
        if (IsEdit && Article != null)
        {
            await articleService.UpdateArticleByIdAsync(
                Article.Id,
                title,
                text,
                author,
                id);
        }
        // Dodawanie nowego artykułu
        else
        {
            await articleService.AddArticleAsync(
                title,
                text,
                author,
                id);
        }
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
    }
}