@using Microsoft.AspNetCore.Components

<div class="admin-card">
    <div class="articles-list">
        @for (int i = 1; i <= 8; i++)
        {
            <div class="article-summary article-card">
                <div class="content">
                    <div>
                        <a class="article-title-link" href="/article/@i">Przykładowy artykuł #@i</a>
                    </div>
                    <div class="article-meta">
                        <span class="meta-author">Redakcja</span>
                        <span>•</span>
                        <span class="meta-date">2026-10-01</span>
                    </div>
                </div>
                <div class="article-actions">
                    <button class="btn-outline" @onclick="() => Edit.InvokeAsync(i)">Edytuj</button>
                    <button class="btn-modern" @onclick="() => Delete(i)">Usuń</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<int> OnEdit { get; set; }

    private EventCallback<int> Edit => OnEdit;

    private void Delete(int id)
    {
        // usuwanie (symulacja)
    }
}
